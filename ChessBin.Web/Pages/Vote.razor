@page "/vote"
@using ChessEngine.Engine

<PageTitle>Community vs Moonforge | ChessBin</PageTitle>

<main class="site-shell">
    <SiteHeader />

    <section class="hero">
        <div>
            <p class="eyebrow">@Eyebrow</p>
            <h1>@Heading</h1>
        </div>
        <p class="intro">
            Everyone votes on one move a day; whichever move gets the most votes is played, and
            Moonforge answers. Vote right here — no account, no signup.
        </p>
    </section>

    @if (_error is not null)
    {
        <section class="puzzle-error" role="alert">
            <strong>The game state didn't load.</strong>
            <p>@_error</p>
            <button class="primary-button" type="button" @onclick="LoadAsync">Try again</button>
        </section>
    }
    else if (_state is null)
    {
        <section class="puzzle-loading" aria-live="polite">Checking the board…</section>
    }
    else if (!_state.HasGame)
    {
        <section class="paste-panel vote-idle">
            <p class="boot-note">
                No game is running at the moment. The next one will be announced on the repository —
                when it starts, the board and the running vote count appear here.
            </p>
            <a class="primary-button" href="https://github.com/3583Bytes/Moonforge-Chess" target="_blank" rel="noreferrer">
                Watch the repository ↗
            </a>
        </section>
    }
    else
    {
        <section class="game-layout" aria-label="Community game">
            <div class="board-column">
                <div class="player-strip opponent">
                    <div class="avatar moonforge-avatar" aria-hidden="true">☾</div>
                    <div>
                        <strong>Moonforge</strong>
                        <span>@(_state.Community == ChessPieceColor.White ? "Black" : "White")</span>
                    </div>
                    <span class="rating-chip">@_state.Fen.Split(' ')[1].ToUpperInvariant() to move</span>
                </div>

                <div class="board-wrap">
                    <ChessBoardView Squares="Squares"
                                    WhiteAtBottom="@(_state.Community == ChessPieceColor.White)"
                                    Interactive="false"
                                    Label="Community game position" />
                </div>

                <div class="player-strip">
                    <div class="avatar human-avatar" aria-hidden="true">Us</div>
                    <div>
                        <strong>The community</strong>
                        <span>@_state.CommunityColor</span>
                    </div>
                </div>

                <p class="status-line" aria-live="polite">
                    <span class="status-icon">@(_state.IsFinished ? "◆" : "●")</span> @Status
                </p>
            </div>

            <aside class="control-panel puzzle-panel">
                <div class="panel-tabs">
                    <button type="button">Game @_state.Game</button>
                    <span>@_state.History.Length ply</span>
                </div>

                <section class="panel-section">
                    <div class="section-heading">
                        <h2>@(_ballot.Tally.Open ? "Pick the next move" : "Voting")</h2>
                        <span>@VoterCount</span>
                    </div>

                    @if (_ballot.Tally.Counts.Count == 0)
                    {
                        <p class="position-message">
                            @(_ballot.Tally.HasRound
                                ? "This round is settled. The next set of moves appears when the referee posts it."
                                : "No round is open yet. When one starts, the moves to choose between appear here.")
                        </p>
                    }
                    else
                    {
                        <ul class="vote-options">
                            @foreach (VoteOption option in _ballot.Tally.Counts)
                            {
                                <li @key="option.San">
                                    <button type="button"
                                            class="vote-option @(option.San == _ballot.MyChoice ? "chosen" : null)"
                                            disabled="@(!_ballot.CanVote)"
                                            aria-pressed="@(option.San == _ballot.MyChoice ? "true" : "false")"
                                            @onclick="() => VoteForAsync(option.San)">
                                        <span class="vote-bar" style="width:@(_ballot.SharePercent(option))%" aria-hidden="true"></span>
                                        <span class="vote-move">@option.San</span>
                                        <span class="vote-count">@option.Votes</span>
                                    </button>
                                </li>
                            }
                        </ul>

                        @if (_ballot.Tally.Open)
                        {
                            @if (_ballot.MyChoice is null)
                            {
                                <p class="position-message">One vote each. You can change it until voting closes.</p>
                            }
                        }
                        else if (_ballot.Leader is VoteOption winner)
                        {
                            <p class="position-message">
                                <strong>@winner.San</strong> is ahead with @winner.Votes of @_ballot.TotalVotes votes.
                                It gets played when the referee next runs.
                            </p>
                        }
                        else if (_ballot.TotalVotes > 0)
                        {
                            <p class="position-message">
                                It's a tie on @_ballot.TotalVotes votes — the referee breaks it by
                                whichever move comes first on the list above.
                            </p>
                        }
                    }

                    @if (_ballot.Message.Length > 0)
                    {
                        <p class="vote-message @(_ballot.MessageIsProblem ? "problem" : "confirmed")" role="status">
                            @_ballot.Message
                        </p>
                    }

                    @if (_state.Issue > 0)
                    {
                        <a class="text-link" href="@IssueUrl" target="_blank" rel="noreferrer">
                            Discuss this move on GitHub ↗
                        </a>
                    }
                </section>

                @if (_state.History.Length > 0)
                {
                    <section class="panel-section">
                        <div class="section-heading">
                            <h2>Moves so far</h2>
                            <span>votes shown</span>
                        </div>
                        <ol class="vote-moves">
                            @foreach (VoteMove m in _state.History.Reverse())
                            {
                                <li class="@(m.IsCommunity ? "by-us" : "by-engine")">
                                    <strong>@m.Reference</strong>
                                    <span>@(m.IsCommunity ? $"{m.Votes} vote{(m.Votes == 1 ? "" : "s")}" : "Moonforge")</span>
                                </li>
                            }
                        </ol>
                    </section>
                }
            </aside>
        </section>
    }

    <footer class="site-footer">
        <span>The board is a file in the repository; a scheduled job is the referee.</span>
        <span>Votes are anonymous — no account, and nothing about you is stored.</span>
    </footer>
</main>

@code {
    private VoteState? _state;
    private Engine? _board;
    private string? _error;
    private readonly VoteBallot _ballot = new();
    private string? _token;

    [Inject] private HttpClient Http { get; set; } = null!;
    [Inject] private IVoteApi Votes { get; set; } = null!;
    [Inject] private IJSRuntime Js { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await RefreshTallyAsync();
    }

    /// <summary>
    /// Fetches the live vote counts. Kept separate from <see cref="LoadAsync"/> so a vote
    /// server that is down or unreachable costs the visitor the buttons and nothing else —
    /// the board comes from a static file and renders regardless.
    /// </summary>
    private async Task RefreshTallyAsync()
    {
        _ballot.Apply(await Votes.GetTallyAsync());
        StateHasChanged();
    }

    private async Task VoteForAsync(string san)
    {
        _ballot.BeginSubmitting();
        StateHasChanged();

        _token ??= await Js.InvokeAsync<string>("chessBin.getPlayerToken");
        _ballot.Apply(await Votes.CastAsync(_token, san), san);
        StateHasChanged();

        // The candidate list moved on without us; get the real one rather than leave stale
        // buttons that will keep failing.
        if (_ballot.MessageIsProblem) await RefreshTallyAsync();
    }

    private string VoterCount => _ballot.Tally.Voters switch
    {
        0 => "no votes yet",
        1 => "1 voter",
        int n => $"{n} voters",
    };

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            // Cache-busted: the state changes on a schedule, and a stale board is worse than
            // a slow one.
            string json = await Http.GetStringAsync($"{VoteChess.StatePath}?v={DateTime.UtcNow:yyyyMMddHHmm}");
            _state = VoteChess.Parse(json);

            var engine = new Engine(_state.Fen);
            engine.GenerateValidMoves();
            _board = engine;
        }
        catch (Exception ex)
        {
            _error = $"{ex.Message} You can retry, or come back in a moment.";
        }

        StateHasChanged();
    }

    private IReadOnlyList<BoardSquare> Squares
    {
        get
        {
            if (_board is null || _state is null) return [];
            VoteMove? last = _state.History.LastOrDefault();
            (int from, int to) = last is null ? (-1, -1) : SquaresOf(last.Uci);
            return BoardView.Squares(_board, _state.Community == ChessPieceColor.White, from, to);
        }
    }

    private static (int From, int To) SquaresOf(string uci) =>
        uci.Length < 4 ? (-1, -1)
        : ((uci[0] - 'a') + (8 - (uci[1] - '0')) * 8, (uci[2] - 'a') + (8 - (uci[3] - '0')) * 8);

    private string Eyebrow => _state is null || !_state.HasGame
        ? "Community game"
        : _state.IsFinished ? $"Game {_state.Game} · finished" : $"Game {_state.Game} · one move a day";

    private string Heading => _state?.IsFinished == true ? _state.Result : "Everyone versus the engine.";

    private string Status
    {
        get
        {
            if (_state is null) return "";
            if (_state.IsFinished) return $"{_state.Result}. Thanks for playing.";
            if (_state.Deadline is not DateTimeOffset deadline) return "Voting is open.";

            TimeSpan left = deadline - DateTimeOffset.UtcNow;
            return left <= TimeSpan.Zero
                ? "Voting has closed — the next move is being counted."
                : $"Voting closes in {(left.TotalHours >= 1 ? $"{(int)left.TotalHours}h {left.Minutes}m" : $"{left.Minutes}m")}.";
        }
    }

    private string IssueUrl => $"https://github.com/3583Bytes/Moonforge-Chess/issues/{_state?.Issue}";
}

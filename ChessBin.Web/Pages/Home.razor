@page "/"
@using ChessEngine.Engine
@implements IDisposable
@using System.Text.Json

<PageTitle>Play Chess vs the Computer, See How It Thinks | ChessBin</PageTitle>

<main class="site-shell @(_lightBoard ? "light-theme" : "")">
    <SiteHeader />

    <section class="hero">
        <div>
            <p class="eyebrow">Free · no signup · nothing to install</p>
            <h1>Play chess.<br /><em>Find out why you lost.</em></h1>
        </div>
        <p class="intro">Play a game, solve today's puzzle, or paste a game from anywhere and have it explained. All free, all in your browser.</p>
    </section>

    <section class="game-layout" aria-label="Chess game">
        <div class="board-column">
            <div class="player-strip opponent">
                <div class="avatar moonforge-avatar" aria-hidden="true">☾</div>
                <div>
                    <strong>Moonforge</strong>
                    <span>@EngineSideLabel</span>
                </div>
                <time class="chess-clock" datetime="@ClockDuration(EngineMilliseconds)">@ClockLabel(EngineMilliseconds)</time>
                @if (_session.IsThinking)
                {
                    <span class="thinking"><i></i><i></i><i></i></span>
                }
            </div>

            <div class="board-wrap">
                <ChessBoardView Squares="_session.GetDisplaySquares()"
                                WhiteAtBottom="_session.WhiteAtBottom"
                                Interactive="@(_session.IsHumanTurn && !_session.HasPendingPromotion)"
                                ShowCoordinates="_showCoordinates"
                                Label="Chess board"
                                ExtraClass="@(_session.IsThinking ? "is-thinking" : null)"
                                LastFrom="@(_session.LastMovePlayed?.FromIndex ?? -1)"
                                LastTo="@(_session.LastMovePlayed?.ToIndex ?? -1)"
                                MoveKey="_session.CurrentPly"
                                OnSquareClick="HandleSquareAsync" />

                @if (_session.HasPendingPromotion)
                {
                    <div class="promotion-card" role="dialog" aria-modal="true" aria-label="Choose promotion piece">
                        <strong>Promote your pawn</strong>
                        <div class="promotion-pieces">
                            @foreach (ChessPieceType type in PromotionPieces)
                            {
                                <button type="button" aria-label="Promote to @type" @onclick="() => PromoteAsync(type)">@Pieces.Glyph(type, _session.HumanColor)</button>
                            }
                        </div>
                        <button class="text-button" type="button" @onclick="CancelPromotion">Cancel</button>
                    </div>
                }
            </div>

            <div class="player-strip">
                <div class="avatar human-avatar" aria-hidden="true">Y</div>
                <div>
                    <strong>You</strong>
                    <span>@HumanSideLabel</span>
                </div>
                <time class="chess-clock" datetime="@ClockDuration(HumanMilliseconds)">@ClockLabel(HumanMilliseconds)</time>
            </div>

            <div class="status-line" aria-live="polite">
                <span class="status-icon">@StatusIcon</span>
                <span>@_session.Status</span>
            </div>

        </div>

        <aside class="control-panel">
            <div class="panel-tabs" role="tablist">
                <button class="active" type="button" role="tab" aria-selected="true">Game</button>
                <span>Analysis</span>
            </div>

            <section class="panel-section setup-section">
                <label>
                    <span>Play as</span>
                    <select @bind="_selectedSide" @bind:after="SaveSettingsAsync" disabled="@_session.IsThinking">
                        <option value="White">White</option>
                        <option value="Black">Black</option>
                    </select>
                </label>
                <label>
                    <span>Strength</span>
                    <select @bind="_selectedDifficulty" @bind:after="SaveSettingsAsync" disabled="@_session.IsThinking">
                        <option value="Easy">Quick</option>
                        <option value="Medium">Club</option>
                        <option value="Hard">Strong</option>
                        <option value="VeryHard">Forge</option>
                    </select>
                </label>
                <label>
                    <span>Time control</span>
                    <select @bind="_selectedTimeControl" @bind:after="SaveSettingsAsync" disabled="@_session.IsThinking">
                        <option value="Unlimited">Unlimited</option>
                        <option value="Bullet">1 + 0</option>
                        <option value="Blitz">3 + 2</option>
                        <option value="Rapid">10 + 0</option>
                    </select>
                </label>
                <button class="primary-button" type="button" disabled="@_session.IsThinking" @onclick="StartNewGameAsync">New game</button>
            </section>

            <section class="panel-section moves-section">
                <div class="section-heading">
                    <h2>Moves</h2>
                <span>@_session.CurrentPly / @_session.Moves.Count</span>
                </div>
                @if (_session.Moves.Count == 0)
                {
                    <p class="empty-state">The game record will appear here.</p>
                }
                else
                {
                    <ol class="move-list">
                        @for (int index = 0; index < _session.Moves.Count; index += 2)
                        {
                            <li>
                                <span class="move-number">@(index / 2 + 1).</span>
                                <button class="move-button @MoveClass(index)" type="button" @onclick="() => _session.NavigateToPly(index + 1)">@_session.Moves[index].Label</button>
                                @if (index + 1 < _session.Moves.Count)
                                {
                                    <button class="move-button @MoveClass(index + 1)" type="button" @onclick="() => _session.NavigateToPly(index + 2)">@_session.Moves[index + 1].Label</button>
                                }
                            </li>
                        }
                    </ol>
                }
                <div class="move-navigation" aria-label="Move navigation">
                    <button type="button" disabled="@(!_session.CanStepBack)" @onclick="() => _session.NavigateToPly(0)" title="First move">|◀</button>
                    <button type="button" disabled="@(!_session.CanStepBack)" @onclick="_session.StepBack" title="Previous move">◀</button>
                    <button type="button" disabled="@(!_session.CanStepForward)" @onclick="_session.StepForward" title="Next move">▶</button>
                    <button type="button" disabled="@(!_session.CanStepForward)" @onclick="() => _session.NavigateToPly(_session.Moves.Count)" title="Last move">▶|</button>
                </div>
            </section>

            <section class="panel-section engine-section">
                <div class="section-heading">
                    <h2>Who's winning</h2>
                    <span class="eval-score">@EvaluationLabel</span>
                </div>
                <div class="eval-track" aria-label="Position score @EvaluationLabel">
                    <span style="width: @EvaluationPercent%"></span>
                </div>
                <p class="position-message">@WhoIsAhead</p>

                @* Search telemetry is for people who want it, not the front of the panel. *@
                <details class="under-the-hood">
                    <summary>Under the hood</summary>
                    <dl class="search-stats">
                        <div><dt>Depth</dt><dd>@SearchDepth</dd></div>
                        <div><dt>Nodes</dt><dd>@SearchNodes</dd></div>
                        <div><dt>Speed</dt><dd>@SearchSpeed</dd></div>
                        <div><dt>Source</dt><dd>@SearchSource</dd></div>
                    </dl>
                    <div class="pv-block">
                        <span>The line it expects</span>
                        <code>@PrincipalVariation</code>
                    </div>
                    <div class="eval-detail">
                        @foreach (var item in EvaluationItems)
                        {
                            <div><span>@item.Label</span><strong>@FormatCentipawns(item.Value)</strong></div>
                        }
                    </div>
                </details>
            </section>

            @if (_session.IsGameOver)
            {
                <section class="panel-section">
                    <GameReviewPanel Review="@(HasReview ? _review : null)"
                                     Busy="_reviewing"
                                     Done="_reviewDone"
                                     Total="_reviewTotal"
                                     OnStart="ReviewGameAsync"
                                     OnSelectPly="JumpToPly" />
                </section>
            }

            <section class="panel-section position-section">
                <div class="section-heading"><h2>Import &amp; share</h2><span>optional</span></div>
                <input class="fen-input" @bind="_fenInput" aria-label="Paste a position"
                       placeholder="Paste a position to set up the board" />
                @if (!string.IsNullOrWhiteSpace(_positionMessage))
                {
                    <p class="position-message">@_positionMessage</p>
                }
                <div class="position-actions">
                    <button type="button" @onclick="LoadFen" title="Set the board from a pasted position (FEN)">Set up</button>
                    <button type="button" @onclick="CopyPgnAsync" title="Copy the game in PGN notation">Copy game</button>
                    <button type="button" @onclick="SharePositionAsync" title="Copy a link to this position">Share link</button>
                </div>
            </section>

            <section class="panel-section progress-section">
                <div class="section-heading"><h2>Your progress</h2><span>this device only</span></div>
                <p class="position-message">
                    Streaks and settings are kept in this browser. Copy the code to carry them to
                    another device — there is no account, so this is the only way across.
                </p>
                <div class="position-actions">
                    <button type="button" @onclick="CopyProgressAsync">@_progressCopyLabel</button>
                    <button type="button" @onclick="() => _showRestore = !_showRestore">Restore…</button>
                </div>

                @if (_showRestore)
                {
                    <input class="fen-input" @bind="_progressCode" aria-label="Progress code"
                           placeholder="Paste a progress code" />
                    <p class="position-message restore-warning">
                        Restoring replaces the streak and settings in this browser.
                    </p>
                    <div class="position-actions">
                        <button type="button" @onclick="RestoreProgressAsync">Replace my progress</button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_progressMessage))
                {
                    <p class="position-message">@_progressMessage</p>
                }
            </section>

            <section class="panel-section settings-section">
                <div class="section-heading"><h2>Board settings</h2><span>Saved locally</span></div>
                <label class="toggle"><input type="checkbox" @bind="_showCoordinates" @bind:after="SaveSettingsAsync" /> Coordinates</label>
                <label class="toggle"><input type="checkbox" @bind="_soundEnabled" @bind:after="SaveSettingsAsync" /> Move sounds</label>
                <label class="toggle"><input type="checkbox" @bind="_lightBoard" @bind:after="SaveSettingsAsync" /> Light board</label>
            </section>

            <footer class="panel-actions">
                <button type="button" disabled="@(!_session.CanUndo)" @onclick="UndoTurn" title="Undo the last turn">↶ <span>Undo</span></button>
                <button type="button" @onclick="FlipBoard" title="Flip board">⇅ <span>Flip</span></button>
                <button type="button" @onclick="CopyFenAsync" title="Copy position">⧉ <span>@_copyLabel</span></button>
            </footer>
        </aside>
    </section>

    <section class="project-section" aria-labelledby="about-moonforge">
        <div class="project-intro">
            <p class="eyebrow">Free forever · no account</p>
            <h2 id="about-moonforge">Everything here is free,<br /><em>and stays on your device.</em></h2>
        </div>

        <div class="project-copy">
            <p>
                Play as many games as you like against Moonforge, solve a new puzzle every day,
                and get any game explained move by move — including games you played somewhere
                else. There is no sign-up, no paywall on the analysis, and no advertising.
            </p>
            <p>
                Everything runs on your own device, so your games never leave the browser. That
                also means it works with no connection once you have visited.
            </p>
            <p class="how-to-play"><strong>How to play:</strong> click one of your pieces, then a highlighted square. When a game ends you get a review that says what each move cost and why — the part most sites charge for.</p>

            <nav class="project-links" aria-label="Moonforge project links">
                <a class="project-link primary" href="https://github.com/3583Bytes/Moonforge-Chess" target="_blank" rel="noreferrer">
                    <span>View source</span>
                    <strong>GitHub ↗</strong>
                </a>
                <a class="project-link" href="https://github.com/3583Bytes/Moonforge-Chess#readme" target="_blank" rel="noreferrer">
                    <span>How the engine works</span>
                    <strong>For developers ↗</strong>
                </a>
                <a class="project-link" href="https://github.com/3583Bytes/Moonforge-Chess/releases" target="_blank" rel="noreferrer">
                    <span>Desktop engine</span>
                    <strong>Releases ↗</strong>
                </a>
                <a class="project-link" href="https://github.com/3583Bytes/Moonforge-Chess/issues" target="_blank" rel="noreferrer">
                    <span>Ideas and bugs</span>
                    <strong>Issue tracker ↗</strong>
                </a>
            </nav>
        </div>
    </section>

    <footer class="site-footer">
        <span>Moonforge Chess runs locally in WebAssembly.</span>
        <span>Open source on GitHub.</span>
    </footer>
</main>

@code {
    private readonly ChessGameSession _session = new();
    private readonly ChessPieceType[] PromotionPieces =
    [
        ChessPieceType.Queen,
        ChessPieceType.Rook,
        ChessPieceType.Bishop,
        ChessPieceType.Knight
    ];
    private ChessPieceColor _selectedSide = ChessPieceColor.White;
    private Engine.Difficulty _selectedDifficulty = Engine.Difficulty.Easy;
    private string _selectedTimeControl = "Unlimited";
    private string _copyLabel = "Copy position";
    private string _fenInput = string.Empty;
    private string _positionMessage = string.Empty;
    private string _progressCode = string.Empty;
    private string _progressMessage = string.Empty;
    private string _progressCopyLabel = "Copy my code";
    private bool _showRestore;
    private bool _showCoordinates = true;
    private bool _soundEnabled;
    private bool _lightBoard;
    private System.Threading.Timer? _clockTimer;
    private GameReviewResult? _review;
    private bool _reviewing;
    private int _reviewDone, _reviewTotal, _reviewedAtPly = -1;
    private CancellationTokenSource? _reviewCancellation;
    private bool _initialized;

    [Inject] private IJSRuntime Js { get; set; } = null!;

    private string HumanSideLabel => _session.HumanColor == ChessPieceColor.White ? "White pieces" : "Black pieces";
    private string EngineSideLabel => _session.HumanColor == ChessPieceColor.White ? "Black pieces" : "White pieces";
    private string StatusIcon => _session.IsThinking ? "◌" : _session.IsGameOver ? "◆" : "●";
    private string EvaluationLabel => FormatCentipawns(_session.Evaluation.Total);

    /// <summary>
    /// The score in words. A number in centipawns means nothing to most players; "roughly
    /// level" does. Attributed, because it is the engine's opinion of a static position.
    /// </summary>
    private string WhoIsAhead
    {
        get
        {
            int mine = _session.Evaluation.Total * (_session.HumanColor == ChessPieceColor.White ? 1 : -1);
            return mine switch
            {
                >= 500 => "Moonforge has you winning comfortably.",
                >= 150 => "Moonforge has you clearly better.",
                >= 50 => "Moonforge has you slightly better.",
                > -50 => "Moonforge has this roughly level.",
                > -150 => "Moonforge has you slightly worse.",
                > -500 => "Moonforge has you clearly worse.",
                _ => "Moonforge has you losing badly.",
            };
        }
    }
    private double EvaluationPercent => Math.Clamp(50 + _session.Evaluation.Total / 20d, 4, 96);
    private string SearchDepth => _session.LastSearch is null ? "—" : _session.LastSearch.Depth.ToString();
    private string SearchNodes => _session.LastSearch is null ? "—" : FormatNodes(_session.LastSearch.TotalNodes);
    private string SearchSpeed => _session.SearchNodesPerSecond == 0 ? "—" : $"{FormatNodes(_session.SearchNodesPerSecond)}/s";
    private string SearchSource => _session.LastSearch is null ? "Waiting" : _session.LastMoveWasBook ? "Opening book" : _session.IsThinking ? "Live" : "Search";
    private string PrincipalVariation => string.IsNullOrWhiteSpace(_session.LastSearch?.PrincipalVariation) ? "No line searched yet." : _session.LastSearch.PrincipalVariation;
    private long HumanMilliseconds => _session.HumanColor == ChessPieceColor.White ? _session.WhiteMilliseconds : _session.BlackMilliseconds;
    private long EngineMilliseconds => _session.HumanColor == ChessPieceColor.White ? _session.BlackMilliseconds : _session.WhiteMilliseconds;

    private IEnumerable<(string Label, int Value)> EvaluationItems
    {
        get
        {
            EvaluationBreakdown e = _session.Evaluation;
            yield return ("Material", e.Material);
            yield return ("Piece activity", e.PieceSquareTables + e.Mobility);
            yield return ("Attack / defense", e.AttackDefense);
            yield return ("Pawn structure", e.PawnStructure);
            yield return ("King safety", e.KingSafety + e.Castling);
            yield return ("Development", e.MinorPieceAdjustments + e.QueenDevelopment);
            yield return ("Tempo / check", e.Tempo + e.Check);
        }
    }


    private async Task CopyProgressAsync()
    {
        string code = await PlayerData.ExportAsync(Js);
        ProgressCodeResult check = PlayerData.Decode(code);

        if (!check.Success)
        {
            // Nothing worth carrying yet — say so rather than handing over a code that
            // will be rejected on the other device.
            _progressMessage = "There is nothing to carry across yet. Play a game or solve a puzzle first.";
            return;
        }

        await Js.InvokeVoidAsync("chessBin.copyText", code);
        _progressCopyLabel = "Copied";
        _progressMessage = "Code copied. Paste it into ChessBin on your other device.";
    }

    private async Task RestoreProgressAsync()
    {
        ProgressCodeResult result = PlayerData.Decode(_progressCode);
        if (!result.Success)
        {
            _progressMessage = result.Error!;
            return;
        }

        await PlayerData.ImportAsync(Js, result.Entries!);
        await ApplyStoredSettingsAsync();

        _progressCode = string.Empty;
        _showRestore = false;
        _progressMessage = $"Restored {result.Entries!.Count} item(s). Your streak and settings now match that device.";
    }

    private async Task StartNewGameAsync()
    {
        _copyLabel = "Copy position";
        _positionMessage = string.Empty;
        await SaveSettingsAsync();
        await _session.NewGameAsync(_selectedSide, _selectedDifficulty, GetTimeControl());
    }

    private async Task HandleSquareAsync(BoardSquare square)
    {
        int moveCount = _session.Moves.Count;
        await _session.ClickSquareAsync(square.Column, square.Row);
        if (_soundEnabled && _session.Moves.Count > moveCount)
            await Js.InvokeVoidAsync("chessBin.playSound", _session.LastMovePlayed?.SoundKind ?? "move");
    }

    private async Task PromoteAsync(ChessPieceType type)
    {
        int moveCount = _session.Moves.Count;
        await _session.CompletePromotionAsync(type);
        if (_soundEnabled && _session.Moves.Count > moveCount)
            await Js.InvokeVoidAsync("chessBin.playSound", _session.LastMovePlayed?.SoundKind ?? "move");
    }

    private void CancelPromotion()
    {
        _session.CancelPromotion();
    }

    private void UndoTurn()
    {
        _session.UndoTurn();
        _copyLabel = "Copy position";
    }

    private void FlipBoard() => _session.FlipBoard();

    private async Task CopyFenAsync()
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", _session.Fen);
        _copyLabel = "Copied";
    }

    private async Task CopyPgnAsync()
    {
        await Js.InvokeVoidAsync("chessBin.copyText", _session.Pgn);
        _positionMessage = "PGN copied to the clipboard.";
    }

    private async Task SharePositionAsync()
    {
        await Js.InvokeVoidAsync("chessBin.shareFen", _session.Fen);
        _positionMessage = "Share link copied to the clipboard.";
    }

    private void LoadFen()
    {
        try
        {
            _session.LoadPosition(_fenInput.Trim(), _selectedSide, _selectedDifficulty);
            _positionMessage = "Position loaded.";
        }
        catch (FormatException)
        {
            _positionMessage = "That FEN is not a valid chess position.";
        }
    }

    protected override void OnInitialized()
    {
        _session.StateChanged += OnSessionChanged;
        _clockTimer = new System.Threading.Timer(_ =>
        {
            _session.TickClock();
            _ = InvokeAsync(StateHasChanged);
        }, null, 250, 250);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;
        await ApplyStoredSettingsAsync();

        string? fen = await Js.InvokeAsync<string?>("chessBin.getFenFromUrl");
        if (!string.IsNullOrWhiteSpace(fen))
        {
            _fenInput = fen;
            LoadFen();
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Reads the stored settings onto the page. Also used after restoring a code.</summary>
    private async Task ApplyStoredSettingsAsync()
    {
        string? json = await Js.InvokeAsync<string?>("chessBin.getSettings");
        if (string.IsNullOrWhiteSpace(json)) return;

        ChessBinSettings? settings;
        try
        {
            settings = JsonSerializer.Deserialize<ChessBinSettings>(json);
        }
        catch (Exception)
        {
            return;   // unreadable settings should never stop the page loading
        }

        if (settings is null) return;

        _selectedSide = settings.Side;
        _selectedDifficulty = settings.Difficulty;
        _selectedTimeControl = settings.TimeControl;
        _showCoordinates = settings.ShowCoordinates;
        _soundEnabled = settings.SoundEnabled;
        _lightBoard = settings.LightBoard;
    }

    private async Task SaveSettingsAsync()
    {
        var settings = new ChessBinSettings(_selectedSide, _selectedDifficulty, _selectedTimeControl, _showCoordinates, _soundEnabled, _lightBoard);
        await Js.InvokeVoidAsync("chessBin.saveSettings", JsonSerializer.Serialize(settings));
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private TimeControl GetTimeControl() => _selectedTimeControl switch
    {
        "Bullet" => TimeControl.Bullet,
        "Blitz" => TimeControl.Blitz,
        "Rapid" => TimeControl.Rapid,
        _ => TimeControl.Unlimited
    };


    /// <summary>A review belongs to the exact position it was run on; undo or a new game drops it.</summary>
    private bool HasReview => _review is not null && _reviewedAtPly == _session.Moves.Count;



    private async Task ReviewGameAsync()
    {
        if (_reviewing || _session.Moves.Count == 0) return;

        _reviewCancellation?.Cancel();
        _reviewCancellation?.Dispose();
        _reviewCancellation = new CancellationTokenSource();

        _reviewing = true;
        _review = null;
        _reviewDone = 0;
        _reviewTotal = _session.Moves.Count + 1;

        try
        {
            _review = await GameReviewer.ReviewAsync(
                _session.InitialFen,
                _session.Moves,
                _session.HumanColor,
                progress: (done, total) =>
                {
                    _reviewDone = done;
                    _reviewTotal = total;
                    StateHasChanged();
                },
                token: _reviewCancellation.Token);
            _reviewedAtPly = _session.Moves.Count;
        }
        catch (OperationCanceledException)
        {
            _review = null;
        }
        finally
        {
            _reviewing = false;
            StateHasChanged();
        }
    }

    /// <summary>Puts the board on the position a reviewed move produced.</summary>
    private void JumpToPly(int ply) => _session.NavigateToPly(ply);


    private string MoveClass(int moveIndex) => _session.CurrentPly == moveIndex + 1 ? "current" : string.Empty;
    private static string ClockLabel(long milliseconds) => milliseconds <= 0 ? "∞" : TimeSpan.FromMilliseconds(milliseconds).ToString(@"m\:ss");
    private static string ClockDuration(long milliseconds) => milliseconds <= 0 ? "PT0S" : $"PT{Math.Ceiling(milliseconds / 1000d)}S";







    private static string FormatCentipawns(int score) => score switch
    {
        > 0 => $"+{score / 100d:0.00}",
        < 0 => $"{score / 100d:0.00}",
        _ => "0.00"
    };

    private static string FormatNodes(long nodes) => nodes switch
    {
        >= 1_000_000 => $"{nodes / 1_000_000d:0.0}m",
        >= 1_000 => $"{nodes / 1_000d:0.0}k",
        _ => nodes.ToString()
    };

    public void Dispose()
    {
        _reviewCancellation?.Cancel();
        _reviewCancellation?.Dispose();
        _clockTimer?.Dispose();
        _session.StateChanged -= OnSessionChanged;
        _session.Dispose();
    }

    private sealed record ChessBinSettings(
        ChessPieceColor Side,
        Engine.Difficulty Difficulty,
        string TimeControl,
        bool ShowCoordinates,
        bool SoundEnabled,
        bool LightBoard);
}

@page "/review"
@using ChessEngine.Engine
@implements IDisposable

<PageTitle>Chess Game Analysis — Paste a PGN | ChessBin</PageTitle>

<main class="site-shell">
    <SiteHeader />

    <section class="hero">
        <div>
            <p class="eyebrow">Game analysis · free · no signup</p>
            <h1>@(_game is null ? "Why did that move lose?" : _game.Title)</h1>
        </div>
        <p class="intro">
            Paste a game from anywhere — Lichess, Chess.com, your own notation — and Moonforge
            will say what each move cost and which part of the position paid for it.
        </p>
    </section>

    <section class="game-layout" aria-label="Game analysis">
        <div class="board-column">
            <section class="paste-panel">
                <label class="paste-label" for="pgn">Paste PGN</label>
                <textarea id="pgn" class="pgn-input" rows="12" spellcheck="false"
                          placeholder="[Event &quot;Rated Blitz game&quot;]&#10;...&#10;&#10;1. e4 e5 2. Nf3 Nc6 3. Bc4 ..."
                          @bind="_pgn" @bind:event="oninput"></textarea>

                <div class="paste-actions">
                    <label class="paste-side">
                        <span>Review from</span>
                        <select @bind="_side">
                            <option value="@ChessPieceColor.White">White's side</option>
                            <option value="@ChessPieceColor.Black">Black's side</option>
                        </select>
                    </label>
                    <button class="primary-button" type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_pgn))"
                            @onclick="ImportAndReviewAsync">
                        @(_busy ? "Working…" : "Analyse this game")
                    </button>
                </div>

                @if (_error is not null)
                {
                    <p class="paste-error" role="alert">@_error</p>
                }
                else if (_game is not null)
                {
                    <p class="position-message">
                        @_game.Moves.Count moves read@(string.IsNullOrWhiteSpace(_game.Result) ? "" : $", result {_game.Result}").
                        @if (!_game.StartsFromStandardPosition)
                        {
                            <text>Starting from the position in the game's FEN tag.</text>
                        }
                    </p>
                }
            </section>

            @if (_board is not null && _game is not null)
            {
                <section class="paste-panel board-panel">
                    <div class="section-heading">
                        <h2>@(_selected?.Reference ?? "Starting position")</h2>
                        <span>@PositionLabel</span>
                    </div>

                    <div class="board-wrap">
                        <ChessBoardView Squares="BoardSquares"
                                        WhiteAtBottom="@(_side == ChessPieceColor.White)"
                                        Interactive="false"
                                        Label="@($"Position after {_ply} of {_game.Moves.Count} moves")" />
                    </div>

                    <div class="move-navigation" aria-label="Step through the game">
                        <button type="button" disabled="@(_ply == 0)" @onclick="() => GoToPly(0)" title="Start">|◀</button>
                        <button type="button" disabled="@(_ply == 0)" @onclick="() => GoToPly(_ply - 1)" title="Previous move">◀</button>
                        <button type="button" disabled="@(_ply >= _game.Moves.Count)" @onclick="() => GoToPly(_ply + 1)" title="Next move">▶</button>
                        <button type="button" disabled="@(_ply >= _game.Moves.Count)" @onclick="() => GoToPly(_game.Moves.Count)" title="End">▶|</button>
                    </div>

                    @if (_selected is not null)
                    {
                        <p class="review-why">@_selected.Explanation</p>
                    }

                    <a class="text-link" href="@($"/?fen={Uri.EscapeDataString(CurrentFen)}")">
                        Play on from this position →
                    </a>
                </section>
            }
        </div>

        <aside class="control-panel puzzle-panel">
            <div class="panel-tabs">
                <button type="button">Analysis</button>
                <span>@(_review is null ? "paste a game" : $"{_review.HumanMoves} of your moves")</span>
            </div>
            <section class="panel-section">
                <GameReviewPanel Review="_review"
                                 Busy="_busy"
                                 Done="_done"
                                 Total="_total"
                                 StartLabel="Analyse this game"
                                 SelectHint="Show the details for this move"
                                 OnStart="ImportAndReviewAsync"
                                 OnSelectPly="Select" />
            </section>
        </aside>
    </section>

    <footer class="site-footer">
        <span>Analysis runs on your device. Nothing you paste is uploaded.</span>
        <span>Moonforge scores positions from named terms, not a neural network.</span>
    </footer>
</main>

@code {
    private string _pgn = string.Empty;
    private ChessPieceColor _side = ChessPieceColor.White;
    private PgnGame? _game;
    private GameReviewResult? _review;
    private ReviewedMove? _selected;
    private string? _error;
    private bool _busy;
    private Engine? _board;
    private int _ply;
    private int _done, _total;
    private CancellationTokenSource? _cancellation;

    private async Task ImportAndReviewAsync()
    {
        if (_busy) return;

        _error = null;
        _review = null;
        _selected = null;

        PgnImportResult parsed = PgnImport.Parse(_pgn);
        if (!parsed.Success)
        {
            _game = null;
            _error = parsed.Error;
            return;
        }

        _game = parsed.Game;
        if (_game!.Moves.Count == 0)
        {
            _error = "That game has no moves to analyse.";
            return;
        }

        _cancellation?.Cancel();
        _cancellation?.Dispose();
        _cancellation = new CancellationTokenSource();

        _busy = true;
        _done = 0;
        _total = _game.Moves.Count + 1;

        try
        {
            _review = await GameReviewer.ReviewAsync(
                _game.StartFen, _game.Moves, _side,
                progress: (done, total) => { _done = done; _total = total; StateHasChanged(); },
                token: _cancellation.Token);
        }
        catch (OperationCanceledException)
        {
            _review = null;
        }
        finally
        {
            _busy = false;

            // Open on the worst moment rather than the starting position — it is what the
            // reader came for, and the navigation is right there to walk back from it.
            GoToPly(_review?.Notable.FirstOrDefault()?.Ply ?? 0);

            StateHasChanged();
        }
    }

    private IReadOnlyList<BoardSquare> BoardSquares
    {
        get
        {
            if (_board is null || _game is null) return [];
            PlayedMove? last = _ply > 0 ? _game.Moves[_ply - 1] : null;
            return BoardView.Squares(_board, _side == ChessPieceColor.White,
                last?.FromIndex ?? -1, last?.ToIndex ?? -1);
        }
    }

    private string CurrentFen => _board?.FEN ?? ChessGameSession.StartingFen;

    private string PositionLabel => _game is null
        ? string.Empty
        : _ply == 0 ? "before the first move" : $"move {_ply} of {_game.Moves.Count}";

    private void Select(int ply) => GoToPly(ply);

    /// <summary>
    /// Replays from the start each time. A game is a few hundred plies at most, so the simple
    /// version is fast enough and cannot drift out of step the way incremental undo could.
    /// </summary>
    private void GoToPly(int ply)
    {
        if (_game is null) return;

        _ply = Math.Clamp(ply, 0, _game.Moves.Count);

        var engine = new Engine(_game.StartFen);
        engine.GenerateValidMoves();
        for (int i = 0; i < _ply; i++)
        {
            if (!PuzzleData.TryApplyUci(engine, _game.Moves[i].Uci)) break;
        }

        _board = engine;
        _selected = _review?.Moves.FirstOrDefault(m => m.Ply == _ply);
    }

    public void Dispose()
    {
        _cancellation?.Cancel();
        _cancellation?.Dispose();
    }
}

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The only culture-sensitive formatting on the site is the puzzle date, which
         renders "24 August 2026" under the invariant culture. Dropping ICU removes the
         globalization shard every visitor would otherwise download. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- GitHub Pages ignores published .br/.gz files and gzips the raw asset on the fly,
         so generating them adds ~5.5 MB of never-read files to every deploy. Set this
         back to true if the site ever moves behind a CDN that serves them (Cloudflare
         would, and brotli beats Pages' gzip by roughly 200 KB on the runtime alone). -->
    <CompressionEnabled>false</CompressionEnabled>
    <AssemblyName>ChessBin.Web</AssemblyName>
    <RootNamespace>ChessBin.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChessCoreEngine\ChessCoreEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time importer: turns the Lichess puzzle CSV into the sharded static JSON
    that ChessBin serves. Deliberately NOT part of ChessCore.sln — it must never
    run in the Pages/release workflows, and its only job is to produce committed data.

    Usage is documented in tools/PuzzleImport/README.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PuzzleImport</AssemblyName>
    <RootNamespace>ChessBin.Tools.PuzzleImport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../ChessCoreEngine/ChessCoreEngine.csproj" />
  </ItemGroup>

</Project>

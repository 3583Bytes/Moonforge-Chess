<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time importer: turns the Lichess chess-openings tables into the sharded static
    JSON the opening explorer reads. Deliberately NOT part of ChessCore.sln — it must never
    run in the Pages/release workflows, and its only job is to produce committed data.

    Usage is documented in tools/OpeningImport/README.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpeningImport</AssemblyName>
    <RootNamespace>ChessBin.Tools.OpeningImport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../ChessCoreEngine/ChessCoreEngine.csproj" />
  </ItemGroup>

</Project>
